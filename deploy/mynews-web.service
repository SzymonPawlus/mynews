[Unit]
Description=mynews feedback endpoint (localhost, behind Caddy)
After=network-online.target

[Service]
WorkingDirectory=%h/mynews
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/mynews/.env
ExecStart=%h/.local/bin/uv run --frozen mynews serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
