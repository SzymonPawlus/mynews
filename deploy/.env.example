# Copy to <repo>/.env on the VPS and fill in. Never commit .env.

# --- Claude (subscription) ---
# On the VPS run `claude setup-token` once and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Models used by `claude -p` (aliases: sonnet, opus, haiku)
MYNEWS_MODEL_SELECT=sonnet
MYNEWS_MODEL_WRITE=sonnet

# --- Email ---
# Default: local send-only Postfix set up by deploy/mail-setup.sh (no login, no TLS on loopback).
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=mynews <mynews@news.example.pl>
MAIL_TO=you@example.com
# Alternative: any authenticated relay, e.g. Gmail app password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
#   SMTP_USER=you@gmail.com   SMTP_PASSWORD=<app password>

# --- Optional sources ---
# Free key: https://open-platform.theguardian.com/access/  (enables guardian-* sources)
GUARDIAN_API_KEY=
