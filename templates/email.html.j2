{%- set c_text = "#1f2328" -%}
{%- set c_muted = "#59636e" -%}
{%- set c_accent = "#0b5cad" -%}
{%- set c_bg_soft = "#f3f5f8" -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>Daily briefing {{ d.date }}</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;">
<div style="max-width:680px;margin:0 auto;padding:20px 16px;font-family:Georgia,'Times New Roman',serif;font-size:16px;line-height:1.55;color:{{ c_text }};">

  <div style="font-family:Arial,Helvetica,sans-serif;font-size:13px;color:{{ c_muted }};letter-spacing:.04em;text-transform:uppercase;">Daily briefing · {{ date_long }}</div>
  <p style="font-size:18px;margin:10px 0 18px;">{{ d.intro }}</p>

  {%- if d.explainer %}
  <div style="background:{{ c_bg_soft }};border-radius:8px;padding:14px 16px;margin:0 0 22px;">
    <div style="font-family:Arial,Helvetica,sans-serif;font-size:12px;color:{{ c_muted }};text-transform:uppercase;letter-spacing:.04em;">Sunday explainer · {{ d.explainer.concept }}</div>
    <h2 style="font-size:20px;margin:6px 0 8px;">{{ d.explainer.title }}</h2>
    {%- for para in d.explainer.body.split("\n\n") %}<p style="margin:0 0 10px;">{{ para }}</p>{% endfor %}
  </div>
  {%- endif %}

  {%- if d.week_in_ai %}
  <h2 style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:{{ c_accent }};text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #d0d7de;padding-bottom:4px;margin:26px 0 12px;">The week in AI</h2>
  {%- for para in d.week_in_ai.split("\n\n") %}<p style="margin:0 0 10px;">{{ para }}</p>{% endfor %}
  {%- endif %}

  {%- for sec in d.sections %}
  <h2 style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:{{ c_accent }};text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #d0d7de;padding-bottom:4px;margin:28px 0 12px;">{{ sec.title }}</h2>
    {%- for s in sec.stories %}
    <div style="margin:0 0 22px;">
      <h3 style="font-size:18px;line-height:1.3;margin:0 0 6px;">{{ s.headline }}</h3>
      {%- if s.previously %}
      <p style="margin:0 0 6px;font-size:14px;color:{{ c_muted }};"><b>Previously:</b> {{ s.previously }}</p>
      {%- endif %}
      <p style="margin:0 0 6px;">{{ s.what_happened }}</p>
      <p style="margin:0 0 6px;"><b>Why it matters:</b> {{ s.why_it_matters }}</p>
      {%- for b in s.background %}
      <div style="background:{{ c_bg_soft }};border-left:3px solid {{ c_accent }};padding:8px 12px;margin:8px 0;font-size:15px;">
        <b>{{ b.name }}</b> — {{ b.explanation }}
      </div>
      {%- endfor %}
      {%- if s.known_concepts %}
      <p style="margin:4px 0;font-size:13px;color:{{ c_muted }};font-family:Arial,Helvetica,sans-serif;">Recall:
        {% for k in s.known_concepts %}<a href="#g-{{ k | slug }}" style="color:{{ c_muted }};">{{ k }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>
      {%- endif %}
      <p style="margin:4px 0 0;font-size:13px;font-family:Arial,Helvetica,sans-serif;color:{{ c_muted }};">
        {%- for l in s.links %}<a href="{{ l.url }}" style="color:{{ c_accent }};">{{ l.source }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
      </p>
    </div>
    {%- endfor %}
  {%- endfor %}

  {%- if d.long_reads %}
  <h2 style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:{{ c_accent }};text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #d0d7de;padding-bottom:4px;margin:28px 0 12px;">Long reads</h2>
  {%- for r in d.long_reads %}
  <p style="margin:0 0 10px;"><a href="{{ r.url }}" style="color:{{ c_accent }};font-weight:bold;">{{ r.title }}</a> <span style="color:{{ c_muted }};font-size:14px;">({{ r.source }})</span><br>{{ r.why_read }}</p>
  {%- endfor %}
  {%- endif %}

  {%- if d.glossary %}
  <h2 style="font-family:Arial,Helvetica,sans-serif;font-size:15px;color:{{ c_accent }};text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid #d0d7de;padding-bottom:4px;margin:28px 0 12px;">Glossary</h2>
  {%- for name, expl in d.glossary.items() %}
  <p id="g-{{ name | slug }}" style="margin:0 0 8px;font-size:14px;"><a name="g-{{ name | slug }}"></a><b>{{ name }}</b> — {{ expl }}</p>
  {%- endfor %}
  {%- endif %}

  <p style="margin:30px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:12px;color:{{ c_muted }};">Generated by mynews. Mark a concept as known: <code>mynews concept understood "Name"</code></p>
</div>
</body>
</html>
